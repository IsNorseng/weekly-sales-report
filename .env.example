# Скопируйте файл в .env и заполните параметры своих баз.
# Пустые параметры подключения не подходят для режима database.

PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DRIVER="ODBC Driver 18 for SQL Server"

# Начало включается, конец исключается.
REPORT_START=2026-11-09
REPORT_END=2026-11-16

# Необязательные фильтры PostgreSQL. Пустое значение отключает фильтр.
PG_OFFER_ID=
PG_GEO=
